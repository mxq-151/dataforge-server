<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bigdata.modules.system.mapper.SysRoleMenuPermissionMapper">

    <select id="selectRolePermission" resultType="com.bigdata.modules.system.entity.SysRoleMenuPermission">
        SELECT * FROM sys_role_menu_permission
    </select>

    <select id="selectMenuPermissionIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_permission_id FROM sys_role_menu_permission WHERE role_id = #{roleId}
    </select>

    <select id="selectMenuPermissionIdsByRoleIds" resultType="java.lang.Long">
        SELECT menu_permission_id FROM sys_role_menu_permission WHERE role_id IN
        <foreach item="roleId" collection="roleIds" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <delete id="deleteByPermissionId">
        DELETE FROM sys_role_menu_permission WHERE menu_permission_id = #{permissionId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM sys_role_menu_permission WHERE role_id = #{roleId}
    </delete>

    <insert id="batchInsertRoleMenuPermissions">
        INSERT INTO sys_role_menu_permission(role_id, menu_permission_id, create_time) VALUES
        <foreach item="permId" collection="permissionIds" separator=",">
            (#{roleId}, #{permId}, #{createTime})
        </foreach>
    </insert>

    <insert id="insertRoleMenuPermission">
        INSERT INTO sys_role_menu_permission(role_id, menu_permission_id, create_time)
        VALUES(#{roleId}, #{permissionId}, #{createTime})
    </insert>

</mapper>