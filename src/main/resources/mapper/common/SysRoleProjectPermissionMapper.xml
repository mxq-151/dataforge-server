<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bigdata.modules.system.mapper.SysRoleProjectPermissionMapper">

    <select id="selectByRoleIdAndProjectId" resultType="com.bigdata.modules.system.entity.SysRoleProjectPermission">
        SELECT * FROM sys_role_project_permission WHERE role_id = #{roleId} AND project_id = #{projectId}
    </select>

    <select id="selectByRoleId" resultType="com.bigdata.modules.system.entity.SysRoleProjectPermission">
        SELECT * FROM sys_role_project_permission WHERE role_id = #{roleId}
    </select>

    <select id="selectByRoleIds" resultType="com.bigdata.modules.system.entity.SysRoleProjectPermission">
        SELECT * FROM sys_role_project_permission WHERE role_id IN
        <foreach item="roleId" collection="roleIds" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <select id="selectByProjectId" resultType="com.bigdata.modules.system.entity.SysRoleProjectPermission">
        SELECT * FROM sys_role_project_permission WHERE project_id = #{projectId}
    </select>

    <delete id="deleteByRoleIdAndProjectId">
        DELETE FROM sys_role_project_permission WHERE role_id = #{roleId} AND project_id = #{projectId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM sys_role_project_permission WHERE role_id = #{roleId}
    </delete>

    <delete id="deleteByProjectId">
        DELETE FROM sys_role_project_permission WHERE project_id = #{projectId}
    </delete>

</mapper>