# ============================================================
# 引擎验证环境变量（复制为 .env.engines 后按需修改；不要提交真实密码）
#
#   cp startup/engines/.env.engines.example startup/engines/.env.engines
#
# 所有值都被 startup/compose/docker-compose.engines.yml 以 ${VAR:-默认} 引用。
# 端口默认与现有 dataforge 编排不冲突（8123/9000/9092/6650/8080/2181/16010/8030/9030/8040）。
# ============================================================

# ---------------- ClickHouse ----------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=dwd
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=dataforge

# ---------------- Kafka（KRaft 单 broker，无鉴权，仅开发/验证） ----------------
KAFKA_PORT=9092
KAFKA_TOPIC=dataforge-e2e

# ---------------- Pulsar standalone（无鉴权，仅开发/验证） ----------------
PULSAR_PORT=6650
PULSAR_HTTP_PORT=8080
PULSAR_TENANT=dataforge
PULSAR_NAMESPACE=default
PULSAR_TOPIC=e2e

# ---------------- HBase standalone ----------------
HBASE_ZK_PORT=2181
HBASE_MASTER_UI_PORT=16010
HBASE_RS_UI_PORT=16030
HBASE_NAMESPACE=dataforge

# ---------------- Apache Doris all-in-one ----------------
DORIS_FE_HTTP_PORT=8030
DORIS_FE_MYSQL_PORT=9030
DORIS_BE_HTTP_PORT=8040
# 容器上限 FE 2g / BE 3g；堆参数与上限的差额留给 metaspace / 堆外
DORIS_FE_HEAP=1536m
DORIS_BE_HEAP=512m
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DB=dwd

# ---------------- StarRocks：未部署（镜像不可得） ----------------
# starrocks/allin1-ubuntu:3.3.5 当前网络不可拉取，本环境不部署 StarRocks 服务，
# 以下仅作为接入配置的静态说明（端口/连接串口径），不参与任何 PASS 判定。
# 宿主端口规划：8031(FE HTTP) / 9031(FE MySQL) / 8041(BE HTTP)，与 Doris 错开。
# JDBC 连接串：jdbc:mysql://starrocks:9030/<db>（容器网络）或 jdbc:mysql://127.0.0.1:9031/<db>（宿主）
# STARROCKS_FE_HTTP_PORT=8031
# STARROCKS_FE_MYSQL_PORT=9031
# STARROCKS_BE_HTTP_PORT=8041
# STARROCKS_USER=root
# STARROCKS_PASSWORD=
# STARROCKS_DB=dwd

# ---------------- Flink ----------------
FLINK_JM_PORT=8081
# 主容器访问 Flink 的地址（写进 docker-compose.yml 的 FLINK_REST_URL）
FLINK_REST_URL=http://flink-jobmanager:8081

# ---------------- dataforge 主服务（verify 脚本登录用） ----------------
DATAFORGE_BASE_URL=http://localhost:8082/api
DATAFORGE_USER=admin
DATAFORGE_PASSWORD=123456
